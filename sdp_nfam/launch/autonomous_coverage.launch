<launch>

  <!-- ═══════════════════════════════════════════════════════════════
       sdp_nfam — Autonomous Metal Detection Coverage
       Launch order: run bringup + rplidar FIRST, then this file.

       Terminal 1:  roslaunch transbot_bringup bringup.launch
       Terminal 2:  roslaunch rplidar_ros rplidar.launch
       Terminal 3:  rosnode kill /transbot_joy /joy_node
       Terminal 3:  roslaunch sdp_nfam autonomous_coverage.launch
       ═══════════════════════════════════════════════════════════════ -->

  <!-- ── gmapping — builds /map + provides /map TF ────────────────
       Runs silently alongside coverage.
       Only reads /scan and /odom, never writes /cmd_vel.
       Required by metal_serial_mapper to place markers in /map.  -->
  <node pkg="gmapping" type="slam_gmapping" name="slam_gmapping"
        output="screen">
    <param name="base_frame"          value="base_footprint"/>
    <param name="odom_frame"          value="odom"/>
    <param name="map_frame"           value="map"/>
    <param name="map_update_interval" value="1.0"/>
    <param name="maxUrange"           value="5.0"/>
    <param name="linearUpdate"        value="0.05"/>
    <param name="angularUpdate"       value="0.05"/>
    <param name="particles"           value="30"/>
    <param name="xmin"                value="-15.0"/>
    <param name="ymin"                value="-15.0"/>
    <param name="xmax"                value="15.0"/>
    <param name="ymax"                value="15.0"/>
    <param name="delta"               value="0.05"/>
    <param name="temporalUpdate"      value="1.0"/>
  </node>

  <!-- ── Metal serial mapper ────────────────────────────────────────
       Reads Arduino over /dev/ttyUSB1.
       Publishes red sphere markers on /metal_detections (MarkerArray).
       Saves CSV to ~/.ros/metal_hits.csv                            -->
  <node pkg="sdp_nfam"
        type="metal_serial_mapper_v2.py"
        name="metal_serial_mapper"
        output="screen">
    <param name="port"                  value="/dev/ttyUSB1"/>
    <param name="baud"                  value="115200"/>
    <param name="frame_base"            value="/base_footprint"/>
    <param name="frame_map"             value="/map"/>
    <param name="coil_forward_offset"   value="0.05"/>
    <param name="coil_left_offset"      value="0.41"/>
    <param name="coil_z"                value="0.03"/>
    <param name="hit_threshold"         value="600"/>
    <param name="debounce_hits"         value="2"/>
    <param name="min_marker_separation" value="0.20"/>
  </node>

  <!-- ── Coverage controller ────────────────────────────────────────
       Asks for zone size on startup (interactive prompt).
       Boustrophedon: Row 0 →, Row 1 ←, Row 2 →, ...
       Ctrl-C at any point safely stops motors and parks arm.       -->
  <node pkg="sdp_nfam"
        type="coverage_metal_detector_v17.py"
        name="metal_detector_coverage"
        output="screen"
        launch-prefix="xterm -e"/>

  <!-- ── RViz — live map + robot + laser + metal markers ───────────
       Opens automatically showing:
         - Grey occupancy map building in real time
         - Red dots where metal was found
         - Red laser scan lines
         - Robot position                                            -->
  <node pkg="rviz" type="rviz" name="rviz"
        args="-d $(find sdp_nfam)/metal_coverage.rviz"
        output="screen"/>

</launch>
